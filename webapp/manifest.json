      "HANACompatibilityModel": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "HANACompatibility",
        "settings": {
          "useBatch": false
        }
      },
      "UpgConRemediationModel": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "UpgConRemediation",
        "settings": {
          "useBatch": false
        }
      },
      "GLBalanceSSModel": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "GLBalances",
        "settings": {
          "useBatch": false
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
