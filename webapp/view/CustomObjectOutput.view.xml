<mvc:View
    controllerName="haneya.controller.CustomObjectOutput"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:smartTable="sap.ui.comp.smarttable">

    <Page title="Custom Object Conflicts" busy="{UiLoadingStatus>/busy}">
        <smartTable:SmartTable
            id="conflictsSmartTable"
            entitySet="Custom_Object_ConflictsSet"
            tableType="ResponsiveTable"
            enableAutoBinding="true"
            useVariantManagement="true"
            useTablePersonalisation="true"
            models="CustObjConModel"
            showRowCount="true"
            beforeRebindTable="onBeforeRebindTable">
            
            <smartTable:customToolbar>
                <Toolbar>
                    <Button
                        icon="sap-icon://repost"
                        tooltip="Reprocess"
                        press="onReprocess"
                        text="AI.PROCESS"
                        type="Emphasized" />
                </Toolbar>
            </smartTable:customToolbar>
        </smartTable:SmartTable>
    </Page>
</mvc:View>
