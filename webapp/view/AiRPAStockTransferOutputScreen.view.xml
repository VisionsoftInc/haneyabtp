<mvc:View
    controllerName="haneya.controller.AiRPAStockTransferOutputScreen"
    xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
	xmlns:m="sap.m"
	xmlns:si="sap.suite.ui.commons.statusindicator"
    height="100%">

    <m:Page
		showHeader="false"
		enableScrolling="false"
		class="sapUiContentPadding"
		busy="{UiLoadingStatus>/busy}">
		<m:content>
			<m:Toolbar>
				<m:ToolbarSpacer/>
    			<m:Button
        			text="AI.PROCESS"
        			icon="sap-icon://repost"
        			type="Emphasized"
        			press="onAiprocess" />
			</m:Toolbar>
			<Table
			    id="stocktransfertable"
    			class="blueHeaderTable"
				rows="{tableModel>/records}"
				selectionMode="MultiToggle"
				paste="onPaste"
				ariaLabelledBy="title">
                <columns>
					<Column width="4rem" hAlign="Center">
    <label>
        <m:Label text="Icon" class="HeaderText"/>
    </label>
    <template>
        <si:StatusIndicator
            width="4rem"
            height="3rem"
            value="{
                path: 'tableModel>Icon',
                formatter: '.formatArrowValue'
            }">

            <si:propertyThresholds>
                <si:PropertyThreshold fillColor="Error" toValue="20"/>
                <si:PropertyThreshold fillColor="Critical" toValue="50"/>
                <si:PropertyThreshold fillColor="Good" toValue="100"/>
            </si:propertyThresholds>

            <si:ShapeGroup>
                <si:LibraryShape shapeId="arrow_right"/>
            </si:ShapeGroup>

        </si:StatusIndicator>
    </template>
</Column>

					<!-- <Column width="11rem">
						<m:Label text="Icon" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>Icon}" />
						</template>
					</Column> -->
					<Column width="11rem">
						<m:Label text="File Id" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>FileId}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Main Id" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>MainId}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="STO PO Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>PoNumber}" />
						</template>
					</Column>
					<Column width="20rem">
						<m:Label text="PO Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>StatusPo}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Delivery Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>DelNumber}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Delivery Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>StatusDel}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="PGI Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>PgiStatus}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="PGI Accounting NO" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>PgiAccNo}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Billing Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>BillNum}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Billing Accounting No" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>BillAccNo}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Billing Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>StatusBill}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="GR Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>GrNumber}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="GR Accounting No" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>GrAccNo}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="GR Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>StatusGr}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Invoice Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>InvNumber}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Invoice Company Accounting Document" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>InvAccNo}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Invoice Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>StatusInv}" />
						</template>
					</Column>
                </columns>    
			</Table>
		</m:content>
	</m:Page>
</mvc:View>
