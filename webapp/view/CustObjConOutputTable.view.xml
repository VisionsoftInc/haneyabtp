<mvc:View
    controllerName="haneya.controller.CustObjConOutputTable"
    xmlns="sap.ui.table"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:u="sap.ui.unified"
	xmlns:c="sap.ui.core"
	xmlns:m="sap.m"
    height="100%">

    <m:Page
		showHeader="false"
		enableScrolling="true"
		class="sapUiContentPadding">
		<m:Title text="Custom Object Conflicts" textAlign="Center" width="100%"></m:Title>
		<m:content>
			<Table
    			class="blueHeaderTable"
				rows="{tableModel>/results}"
				selectionMode="MultiToggle"
				paste="onPaste"
				rowMode="Auto"
				ariaLabelledBy="title">
                <columns>
					<Column width="11rem">
						<m:Label text="S_NO" class="HeaderText"/>
						<template>
							<m:Text text="{tableModel>COLUMN}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Line Number " class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN1}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="program name" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN2}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Description" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN3}" />
						</template>
					</Column>
					<Column width="20rem">
						<m:Label text="Object Type" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN4}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="System ID" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN5}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Text" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN6}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Package" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN7}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="TR Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN8}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN9}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Automatic/Manual" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN10}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="MESSAGE_TYPE" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>COLUMN11}" />
						</template>
					</Column>
                </columns>    
			</Table>
		</m:content>
	</m:Page>
</mvc:View>
