<mvc:View controllerName="haneya.controller.CustomObject"
    xmlns:l="sap.ui.layout" 
    xmlns:f="sap.ui.layout.form" 
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">


    <Page showHeader="false" class="sapUiSizeCompact" busy="{UiLoadingStatus>/busy}">

        <VBox class="bigBlackBox">
        <Title text="Custom Object Conflicts" level="H6" textAlign="Center" width="100%" />

            <f:SimpleForm
                editable="true">

                <Label text="Application" />
                <HBox>
                    <Input width="40%" />
                </HBox>

                <Label text="Program Name" />
                <HBox>
                    <Input id="programInput" width="90%" />
                </HBox>

                <Label text="Package Name" />
                <HBox>
                    <Input id="packageInput" width="90%" />
                </HBox>


                <Label text="Download" class="HeadText" />
                <CheckBox />

            </f:SimpleForm>

        </VBox>

        <Label text="Please provide either Package or Program for better performance" />

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button text="Execute" type="Emphasized" tooltip="Execute" press="OnPressExecute"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>
