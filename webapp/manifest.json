{
  "_version": "1.76.0",
  "sap.app": {
    "id": "haneya",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.19.5",
      "toolsId": "31e89c53-71b4-4d88-8184-c455de1dad83"
    },
     "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/VSHANEYA/EVT_ST_SRV/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "StockTransfer": {
      "uri": "/sap/opu/odata/VSHANEYA/ZSTO_TRANS_IN_SRV/",
      "type": "OData",
      "settings": {
        "annotations": [],
        "localUri": "localService/StockTransfer/metadata.xml",
        "odataVersion": "2.0"
      }
    },
      "CustomObjectConflicts": {
      "uri": "/sap/opu/odata/VSHANEYA/CUS_OBJ_CON_SRV/",
      "type": "OData",
      "settings": {
        "annotations": [],
        "localUri": "localService/CustomObjectConflicts/metadata.xml",
        "odataVersion": "2.0"
      }
    },
    "HireToRetire":{
      "uri": "/sap/opu/odata/VSHANEYA/HTR_AI_PROCESS_SRV/",
      "type": "OData",
      "settings": {
        "annotations": [],
        "localUri": "localService/CustomObjectConflicts/metadata.xml",
        "odataVersion": "2.0"
      }},
      "HANACompatibility": {
      "uri": "/sap/opu/odata/VSHANEYA/HANA_COMPATIBILITY_SRV/",
      "type": "OData",
      "settings": {
        "annotations": [],
        "localUri": "localService/HANACompatibility/metadata.xml",
        "odataVersion": "2.0"
      }
    },
      "UpgConRemediation": {
      "uri": "/sap/opu/odata/VSHANEYA/UPG_CON_REMEDIATION_SRV/",
      "type": "OData",
      "settings": {
        "annotations": [],
        "localUri": "localService/UpgConRemediation/metadata.xml",
        "odataVersion": "2.0"
      }
    },
     "GLBalances": {
      "uri": "/sap/opu/odata/VSHANEYA/RTR_AI_PROCESS_SRV/",
      "type": "OData",
      "settings": {
        "annotations": [],
        "localUri": "localService/GLBalances/metadata.xml",
        "odataVersion": "2.0"
      }
    },
     "AuthObjRemediation": {
      "uri": "/sap/opu/odata/VSHANEYA/SECURITY_ROLES_REMDI_SRV/",
      "type": "OData",
      "settings": {
        "annotations": [],
        "localUri": "localService/AuthObjRemediation/metadata.xml",
        "odataVersion": "2.0"
      }
    }
  },
  "crossNavigation": {
      "inbounds": {
        "haneya-display": {
          "semanticObject": "haneya",
          "action": "display",
          "title": "{{haneya-display.flpTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.142.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "haneya.i18n.i18n"
        }
      },
      "MigrationModel": {
      "type": "sap.ui.model.json.JSONModel",
      "data": {
        "selectedGroup": "",
        "selectedHeader": ""
        }
      },
      "AuthObjRemediationModel": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "AuthObjRemediation",
        "settings": {
          "useBatch": false
        }
      },
      "SecRoleRemediationModel": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "AuthObjRemediation",
        "settings": {
          "useBatch": false
        }
      },
      "aiprocess": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "mainService",
        "settings": {
          "useBatch": false
        }
      },
      "stockTransferModel": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "StockTransfer",
        "settings": {
          "useBatch": false
        }
      },
      "CustObjConModel": {
        "type": "sap.ui.model.odata.v2.ODataModel",
        "dataSource": "CustomObjectConflicts",
        "settings": {
          "useBatch": false
        }
