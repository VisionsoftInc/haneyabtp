<mvc:View 
    controllerName="haneya.controller.UpgConRemediationSS"
    xmlns:l="sap.ui.layout" 
    xmlns:f="sap.ui.layout.form" 
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page showHeader="false" class="sapUiSizeCompact" busy="{UiLoadingStatus>/busy}">

        <VBox class="bigBlackBox">
        <Title text="Upgrade Conflicts Remediation" level="H6" textAlign="Center" width="100%" />
            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                adjustLabelSpan="true">

                <Label text="Application" class="HeadText"/>
                <Input width="30%"></Input>

                <Label text="Program Name" class="HeadText" />
                <Input id="Programid" width="30%"></Input>

                <Label text="Message Type" class="HeadText" />
                <Input id="Messageid" width="30%"></Input>

                <Label text="Select any" class="HeadText"/>
                <VBox>
                    <RadioButtonGroup id="ActionGroup" columns="1">
                        <RadioButton text="Remediate"/>
                        <RadioButton text="Rollback"/>
                    </RadioButtonGroup>
                </VBox>

            </f:SimpleForm>
            
        </VBox>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button text="Execute" type="Emphasized" tooltip="Execute" press="OnPressExecute"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>
