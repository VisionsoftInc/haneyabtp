<m:Page
		showHeader="false"
		enableScrolling="false"
		class="sapUiContentPadding"
		busy="{UiLoadingStatus>/busy}">
		<m:content>
			<m:Toolbar>
				<m:Text text="Hire To Retire" class="headertext" width="100%" textAlign="Center"></m:Text>
				<m:ToolbarSpacer/>
    			
			</m:Toolbar>
			<Table
			    id="GLBalancetable"
    			class="blueHeaderTable"
				rows="{HireToRetireData>/results}"
				selectionMode="MultiToggle"
				paste="onPaste"
				ariaLabelledBy="title">

                <columns>
					<Column width="11rem">
						<m:Label text="PERNR" class="HeaderText"/>
						<template>
							<m:Text text="{HireToRetireData>PERNR}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Status" class="HeaderText" />
						<template>
							<m:Text text="{HireToRetireData>STATUS}" />
						</template>
					</Column>
                </columns>    
			</Table>
		</m:content>
	</m:Page>



</mvc:View>