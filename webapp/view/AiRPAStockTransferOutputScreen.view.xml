        			type="Emphasized"
        			press="onAiprocess" />
			</m:Toolbar>
			<Table
    			class="blueHeaderTable"
				rows="{tableModel>/records}"
				selectionMode="MultiToggle"
				paste="onPaste"
				ariaLabelledBy="title">
				<extension>
					<m:OverflowToolbar style="Clear">
						<m:Title id="title" text="Products"/>
					</m:OverflowToolbar>
				</extension>
                <columns>
					<Column width="11rem">
						<m:Label text="Icon" class="HeaderText"/>
						<template>
							<m:Text text="{tableModel>Icon}" />
						</template>
					</Column>
					<!-- <Column width="11rem">
						<m:Label text="Selection" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>Sel}" />
						</template>
					</Column> -->
					<Column width="11rem">
						<m:Label text="File Id" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>FileId}" />
						</template>
					</Column>
					<!-- <Column width="11rem">
						<m:Label text="File Name" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>FileName}" />
						</template>
					</Column> -->
					<Column width="11rem">
						<m:Label text="Main Id" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>MainId}" />
						</template>
					</Column>
					<!-- <Column width="11rem">
						<m:Label text="Sub Id" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>SubId}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Product" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>Product}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Distribution" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>DistCenter}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Plant" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>Plant}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Quantity" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>Quantity}" />
						</template>
					</Column> -->
					<Column width="11rem">
						<m:Label text="STO PO Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>PoNumber}" />
						</template>
					</Column>
					<Column width="20rem">
						<m:Label text="PO Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>StatusPo}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Delivery Number" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>DelNumber}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="Delivery Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>StatusDel}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="PGI Status" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>PgiStatus}" />
						</template>
					</Column>
					<Column width="11rem">
						<m:Label text="PGI Accounting NO" class="HeaderText" />
						<template>
							<m:Text text="{tableModel>PgiAccNo}" />
