<mvc:View
    controllerName="haneya.controller.AiRPAConsignmentSalesOutput"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Inter Company Sales Consignment" busy="{UiLoadingStatus>/busy}" busyIndicatorDelay="0" >

        <headerContent>
            <Button text="Reprocess" press="onReprocessPress"/>
        </headerContent>

        <ScrollContainer horizontal="true">

            <Table
                id="ConsignmentTable"
                inset="false"
                items="{ConsignmentModel>/records}"
                 updateFinished="onTableUpdateFinished">

                <!-- Columns -->
           <columns>   
           <Column width="5rem"><Text text="Select"/></Column>
        <Column width="8rem"><Text text="Sales Order"/></Column>
        <Column width="16rem"><Text text="SO Status"/></Column>
        <Column width="10rem"><Text text="Outbound Delivery"/></Column>
        <Column width="18rem"><Text text="Outbound Status"/></Column>
        <Column width="10rem"><Text text="PGI Number"/></Column>
        <Column width="18rem"><Text text="PGI Status"/></Column>
        <Column width="10rem"><Text text="Created On"/></Column>
        <Column width="10rem"><Text text="Remarks"/></Column>
    </columns>

                <!-- Row template -->
                <ColumnListItem class="{= ${ConsignmentModel>REMARKS} === 'SUCCESS' ? 'rowSuccess' : 'rowError' }">
                    <cells>
                     <CheckBox
                        selected="{ConsignmentModel>selected}"
                        visible="{= ${ConsignmentModel>REMARKS} !== 'SUCCESS' }"
                        enabled="{= ${ConsignmentModel>REMARKS} !== 'SUCCESS' }"
/>
                        <Text text="{ConsignmentModel>SO_NUMBER}"/>
            <Text text="{ConsignmentModel>SO_STATUS}"/>
            <Text text="{ConsignmentModel>OUT_DELIVERY}"/>
            <Text text="{ConsignmentModel>OUTBOND_STS}"/>
            <Text text="{ConsignmentModel>PGI_NUMBER}"/>
            <Text text="{ConsignmentModel>PGI_STS}"/>
            <Text text="{ConsignmentModel>CREATED_ON}"/>
            <Text text="{ConsignmentModel>REMARKS}"/>
                    </cells>
                </ColumnListItem>

            </Table>

        </ScrollContainer>
    </Page>
</mvc:View>
